PROJECT_NAME="ExamForge AI"
ENVIRONMENT="development"
DEBUG=True
# Use SQLite for local development or PostgreSQL for production / Supabase:
# DATABASE_URL="postgresql+psycopg2://user:password@localhost:5432/examforge"
DATABASE_URL="sqlite:///./examforge.db"

SECRET_KEY="your-secret-key-at-least-32-chars-long"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider Settings
GEMINI_API_KEY="your_google_gemini_api_key_here"
DEFAULT_AI_PROVIDER="gemini"
DEFAULT_AI_MODEL="gemini-2.5-flash"

# Storage
MAX_UPLOAD_SIZE_MB=50
